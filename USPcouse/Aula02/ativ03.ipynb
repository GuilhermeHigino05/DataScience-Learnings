   "source": [
    "*Crie uma função que dado dois vetores retorna a concatenação desse vetores*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "6a630400",
   "metadata": {},
   "outputs": [],
   "source": [
    "def concat(vet, vet2):\n",
    "    vet3 = []\n",
    "    vet3 = vet + vet2;\n",
    "    print(vet3)"
   ]
  },
